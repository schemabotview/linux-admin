   "cmd": "echo '127.0.0.1 sysops.example' | sudo tee -a /etc/hosts",
   "wait": "password for sysops: $"
  },
  {
   "secret": "sysops"
  },
  "getent hosts sysops.example",
  "resolvectl query sysops.example"
 ]
