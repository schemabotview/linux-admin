{
 "note": "8.3: /etc/hosts, the lookup order, and naming the site on the server itself.",
 "session": [
  {
   "hidden": [
    "ssh web-01",
    "clear"
   ]
  },
  "cat /etc/hosts",
  "grep ^hosts: /etc/nsswitch.conf",
  "getent hosts sysops.example; echo \"exit $?\"",
