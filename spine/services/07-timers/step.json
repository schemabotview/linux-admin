{
 "note": "7.7: report.timer: enabled, listed, and the unit it starts.",
 "volatile": true,
 "upload": {
  "lab/files/report.timer": "/tmp/report.timer"
 },
 "session": [
  {
   "hidden": [
    "ssh web-01",
    "clear"
   ]
  },
  {
   "cmd": "sudo cp /tmp/report.timer /etc/systemd/system/",
   "wait": "password for sysops: $"
  },
  {
   "secret": "sysops"
  },
  "cat /etc/systemd/system/report.timer",
  "sudo systemctl daemon-reload",
  "sudo systemctl enable --now report.timer",
  "systemctl list-timers report.timer --no-pager",
  "systemctl is-enabled report.timer report.service"
 ]
}
