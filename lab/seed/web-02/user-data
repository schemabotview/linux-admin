package_update: false
package_upgrade: false
runcmd:
  # the 10.2 tree, through the lab host's package cache (lab/aptcache.py), which pins it after the first fetch
  - [sh, -c, "sed -i -e 's/^mirrorlist=/#mirrorlist=/' -e 's|^#baseurl=http://dl.rockylinux.org/$contentdir/$releasever|baseurl=http://dl.rockylinux.org/pub/rocky/10.2|' /etc/yum.repos.d/rocky*.repo"]
  - [sh, -c, "echo proxy=http://10.0.2.2:3142 >> /etc/dnf/dnf.conf"]
  # nothing may run dnf or move the clock behind a replay's back
  - [systemctl, disable, --now, dnf-makecache.timer, chronyd.service]
  - [touch, /etc/cloud/cloud-init.disabled]
